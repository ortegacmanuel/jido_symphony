# Partner Middleware project configuration for local testing
# Source this before running: source .env.partner-middleware

# Project config (multi-project mode)
export SYMPHONY_PROJECTS='partner-middleware:/home/covertech/kodo/partner-middleware/WORKFLOW.md'

# Fallback single-project mode (if :projects config not set)
export WORKFLOW_PATH=/home/covertech/kodo/partner-middleware/WORKFLOW.md

# GitHub access (partner-hub repo)
# gh must be authenticated as mortegaatcover
export GH_TOKEN_PARTNER_MIDDLEWARE=$(gh auth token)

# Anthropic API for coordinator LLM calls (triage, decompose, classify)
export ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY:-}

# ProophboardBridge (optional — set these if you want bridge active)
# export PROOPHBOARD_API_KEY=your_key
# export PROOPHBOARD_WORKSPACE_ID=your_workspace
# export PROOPHBOARD_OUR_SYSTEM_LANES="Partner Hub,Hub API"

# Server
export PORT=4010
